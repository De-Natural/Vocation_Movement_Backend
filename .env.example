# ══════════════════════════════════════════════════════════════════
#  Vocation Movement Backend — Environment Variables (PRD §9.1)
#  Copy this file to `.env` and fill in real values for production.
#  For local development, the committed `.env` uses stub adapters so
#  the app boots with ZERO external accounts.
# ══════════════════════════════════════════════════════════════════

# ─── Runtime ───
NODE_ENV=development
PORT=4000
# Public origin of the frontend — used for CORS + email links
FRONTEND_URL=http://localhost:3000
# Base URL of THIS api (used to build links, e.g. verification callbacks)
API_URL=http://localhost:4000

# ─── Database (PostgreSQL 16) ───
DATABASE_URL=postgresql://vocation:vocation@localhost:5432/vocation?schema=public

# ─── Redis (sessions, rate limiting, queue) ───
REDIS_URL=redis://localhost:6379

# ─── JWT (RS256) ───────────────────────────────────────────────────
# In production supply RS256 PEM keys. If left blank in development,
# the app auto-generates an ephemeral key pair on boot (dev only).
# Newlines must be escaped as \n when placed on one line.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800

# ─── Provider mode ─────────────────────────────────────────────────
# "stub"  → no external calls; uploads saved to ./storage, payments &
#           emails simulated & logged. Great for local dev + tests.
# "live"  → use the real SDK for each provider that has keys set.
PROVIDER_MODE=stub

# ─── Payments: Stripe (international cards) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Payments: Paystack (NGN/GHS/KES/ZAR) ───
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ─── File storage: AWS S3 (private docs, receipts, reports) ───
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# ─── File storage: Cloudinary (profile photos, message attachments) ───
CLOUDINARY_URL=

# ─── Email (Resend or SendGrid) ───
RESEND_API_KEY=
EMAIL_FROM="Vocation Movement <no-reply@vocationmovement.org>"

# ─── Platform defaults (overridable via admin settings) ───
DEFAULT_CURRENCY=USD
MIN_GIFT_CENTS=100
PLATFORM_FEE_PERCENT=0

# ─── Demo clock (optional) ─────────────────────────────────────────
# Freeze "now" so overdue-bill logic matches the seed + frontend demo
# data (both treat 2026-08-18 as today). Leave blank in production to
# use the real system clock. Token expiry always uses the real clock.
NOW_OVERRIDE=

# ─── Bootstrap admin (seeded — admins never self-register) ───
SEED_ADMIN_EMAIL=admin@vocationmovement.org
SEED_ADMIN_PASSWORD=ChangeMe!Admin123
